# ================================================================================
# POLYARGUMINDS ENVIRONMENT CONFIGURATION
# ================================================================================

# Database & Cache (PostgreSQL with pgvector for production, MongoDB Atlas, or SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./polyarguminds.db
# POSTGRES_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/polyarguminds
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Tiered Routing)
# OpenRouter (Recommended for access to Llama 3.3 70B, Gemini, Claude, GPT-4o)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAST_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
REASONING_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Other Direct Providers (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Web Search Grounding Tool (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
